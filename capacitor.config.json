{
  "appId": "com.royalluxurylaundry.app",
  "appName": "Royal Luxury Laundry",
  "webDir": "www",
  "bundledWebRuntime": false,
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0b1b12",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
